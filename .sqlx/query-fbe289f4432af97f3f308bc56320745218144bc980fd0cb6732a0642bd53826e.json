{
  "db_name": "PostgreSQL",
  "query": "\n    SELECT\n      a.audit_id,\n      a.trading_pair_id,\n      p.symbol AS \"symbol!\",\n      a.action,\n      a.changed_by,\n      a.occurred_at\n    FROM trading_pair_audit a\n    INNER JOIN trading_pairs p ON p.id = a.trading_pair_id\n    ORDER BY a.occurred_at DESC, a.audit_id DESC\n    LIMIT $1\n    ",
