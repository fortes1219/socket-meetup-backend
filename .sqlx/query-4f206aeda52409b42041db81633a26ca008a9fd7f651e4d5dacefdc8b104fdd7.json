  "query": "\n    SELECT\n      symbol,\n      \"interval\",\n      open_time,\n      close_time,\n      open,\n      high,\n      low,\n      close,\n      volume,\n      trades_count\n    FROM klines\n    WHERE symbol = $1 AND \"interval\" = $2 AND open_time < $3\n    ORDER BY open_time DESC\n    LIMIT $4\n    ",
