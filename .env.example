# Database(postgres 與 rust-api 共用,docker-compose 從這裡讀)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo

# Composed for sqlx-cli + 本機 cargo run(host 上連 docker postgres 用 localhost)
# 必須對齊上面 POSTGRES_*
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo

# Admin
ADMIN_TOKEN=replace-with-strong-random-secret

# Logging
RUST_LOG=info,rust_api=debug

# Binance upstream
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443
